{
  "name": "@seridian-dev/kanban-cli",
  "version": "0.1.0",
  "description": "CLI for Kanban project planning, work items, sprints, and agent workflows.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/seridian-dev/kanban-cli.git" },
  "homepage": "https://github.com/seridian-dev/kanban-cli#readme",
  "bugs": { "url": "https://github.com/seridian-dev/kanban-cli/issues" },
  "keywords": ["kanban", "project-management", "cli", "coding-agents", "convex"],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "kanban": "dist/kanban.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
